# Copy to .env. Keep real credentials only in ignored .env or a secret manager.
# AI runs automatically when provider configuration is valid.
# Remote providers require deployment-level consent. Never send raw file bytes.
LLM_API_KEY=
LLM_MODEL=qwen3.6-35b-a3b-ud-q3_k_m
LLM_BASE_URL=https://studio-unmapped-vicinity.ngrok-free.dev/v1
CONSENT_CLOUD_LLM=true
LLM_ALLOWED_HOSTS=studio-unmapped-vicinity.ngrok-free.dev
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2
LLM_RPM=60
LLM_TPM_LIMIT=30000
LLM_TUNNEL_USERNAME=
LLM_TUNNEL_PASSWORD=

# Local analysis services.
DATABASE_URL=postgresql+psycopg://app:app-local-password@postgres:5432/analysis
REDIS_URL=redis://redis:6379/0
POSTGRES_DB=analysis
POSTGRES_USER=app
POSTGRES_PASSWORD=app-local-password
DATA_ROOT=/data
FRONTEND_ORIGIN=http://localhost:3000

# Upload and cleanup limits.
MAX_FILE_MB=100
TTL_HOURS=24

# Static analysis tool settings.
GHIDRA_MODE=real
GHIDRA_TIMEOUT_SECONDS=900

# API-mediated worker authorization. Use one random value in API and worker.
PIPELINE_AI_INTERNAL_TOKEN=
PIPELINE_AI_API_URL=http://api:8000/api/v1/ai/internal/analyses
PIPELINE_AI_REQUEST_TIMEOUT_S=150

# AI selection and input limits.
FUNC_AI_K=50
FUNC_MAX_CHARS=12000
