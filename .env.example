# PolyStrata runs locally on http://127.0.0.1:8080 and serves an OpenAI-compatible
# API at /v1. Expose it through an ngrok HTTPS tunnel protected by a traffic policy.
# Never commit actual credentials; fill them in your local .env only.
#
# Start ngrok:
#   ngrok http 8080 --traffic-policy-file polystrata-traffic.yaml
# The traffic policy (polystrata-traffic.yaml) requires Authorization: Bearer <key>
# on every request, matching LLM_API_KEY below.

LLM_MODEL=qwen3.6-35b-a3b-ud-q3_k_m
LLM_BASE_URL=https://<ngrok-hostname>/v1
# Set to true only when you intend to allow API -> configured AI endpoint requests.
CONSENT_CLOUD_LLM=true
# Allowlist only the exact ngrok hostname (no suffix matches, no wildcards).
LLM_ALLOWED_HOSTS=<ngrok-hostname>
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2
LLM_RPM=60
LLM_TPM_LIMIT=30000
# ngrok tunnel auth is enforced by the traffic policy file, not CLI --auth.
LLM_TUNNEL_USERNAME=
LLM_TUNNEL_PASSWORD=
# PolyStrata bearer key (sent as Authorization: Bearer). Must match the bearer
# token required by polystrata-traffic.yaml.
LLM_API_KEY=LLM_API_KEY

GHIDRA_CONCURRENCY=1
MAX_FILE_MB=100
ANALYSIS_TIMEOUT_S=900
WORKER_MEM_LIMIT=8g
ARTIFACT_MAX_BYTES=2147483648
TTL_HOURS=24
QUEUE_MAX=10
FUNC_AI_K=50
STAGE2_MAX_CHARS=80000
STAGE3_MAX_CHARS=40000
FUNC_MAX_CHARS=12000
UPLOAD_TMP_QUOTA_MB=512
DATABASE_URL=postgresql+psycopg://app:app-local-password@postgres:5432/analysis
REDIS_URL=redis://redis:6379/0
POSTGRES_PASSWORD=app-local-password
DATA_ROOT=/data
GHIDRA_MODE=fixture
# Internal worker -> API authorization for the API-mediated pipeline AI stage.
# Generate a unique random token (at least 32 characters) and use the same value for both services.
PIPELINE_AI_INTERNAL_TOKEN=
PIPELINE_AI_API_URL=http://api:8000/api/v1/ai/internal/analyses
PIPELINE_AI_REQUEST_TIMEOUT_S=150
